        "weight": 600,
        "tracking": "-0.03em"
      },
      "h1": {
        "min": 34,
        "max": 42,
        "lineHeight": 1.08,
        "weight": 600,
        "tracking": "-0.03em"
      },
      "h2": {
        "min": 28,
        "max": 33,
        "lineHeight": 1.12,
        "weight": 600,
        "tracking": "-0.03em"
      },
      "h3": {
        "min": 20,
        "max": 27,
        "lineHeight": 1.25,
        "weight": 500,
        "tracking": "-0.01em"
      },
      "h4": {
        "min": 17,
        "max": 21,
        "lineHeight": 1.35,
        "weight": 600,
        "tracking": "-0.005em"
      },
      "body-lg": {
        "min": 17,
        "max": 19,
        "lineHeight": 1.6,
        "weight": 400,
        "tracking": "0em"
      },
      "body": {
        "min": 15,
        "max": 16,
        "lineHeight": 1.6,
        "weight": 400,
        "tracking": "0em"
      },
      "small": {
        "min": 13,
        "max": 14,
        "lineHeight": 1.5,
        "weight": 400,
        "tracking": "0em"
      },
      "caption": {
        "min": 12,
        "max": 12,
        "lineHeight": 1.4,
        "weight": 500,
        "tracking": "0.06em"
      }
    }
  },
  "space": {
    "unit": 4,
    "scale": [
      0,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96,
      128
    ]
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,.4)",
    "md": "0 8px 24px -8px rgba(0,0,0,.6)",
    "lg": "0 32px 80px -24px rgba(0,0,0,.8)",
    "glow": "0 0 0 1px rgba(255,255,255,.04), 0 24px 80px -20px var(--accent-glow)"
