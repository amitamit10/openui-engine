{
  "meta": {
    "name": "OpenUI Engine",
    "style": "aurora-dark",
    "mode": "dark",
    "category": "devtool",
    "description": "Aurora Dark art direction for OpenUI Engine. Deep ink canvas, soft violet/cyan light bleeding from behind a product shot. Calm, precise, premium."
  },
  "color": {
    "bg": "#07070c",
    "surface": "#0e0e16",
    "surface2": "#151522",
    "border": "#26263a",
    "text": "#f4f4f8",
    "muted": "#9a9ab2",
    "accent": "#7c6cff",
    "accentFg": "#06060a",
    "accentSoft": "#1a1733",
    "accent2": "#f3bc68",
    "success": "#4ade80",
    "warning": "#fbbf24",
    "danger": "#f87171",
    "accent2Fg": "#0b0b10",
    "successFg": "#0b0b10",
    "warningFg": "#0b0b10",
    "accentText": "#8171ff"
  },
  "font": {
    "display": "'Inter Tight', 'Inter', ui-sans-serif, system-ui, sans-serif",
    "body": "'Inter', ui-sans-serif, system-ui, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
    "googleFamilies": [
      "Inter+Tight:wght@500;600;700",
      "Inter:wght@400;500;600",
      "JetBrains+Mono:wght@400;500"
