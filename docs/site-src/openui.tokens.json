  "border": {
    "width": 1
  },
  "motion": {
    "intensity": 2,
    "fast": "140ms",
    "base": "240ms",
    "slow": "520ms",
    "easing": "cubic-bezier(.2,.7,.2,1)"
  },
  "layout": {
    "container": 1200,
    "gutter": 24,
    "sectionY": {
      "min": 56,
      "max": 104
    },
    "grid": 12
  },
  "composition": {
    "heroVariant": "centered-product",
    "ctaHierarchy": "one-primary-one-ghost",
    "imageTreatment": "Product UI framed in a 1px hairline card with a soft accent glow behind; no stock photography.",
    "sectionTransition": "Hairline dividers and radial accent glows; surfaces step up one elevation per layer."
  }
}
